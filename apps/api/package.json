{
  "name": "@collabboard/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --format=esm --packages=external --alias:@collabboard/contracts=../../packages/contracts/src/index.ts --outfile=dist/main.js --sourcemap",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/platform/database/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/platform/database/seed.ts"
  },
  "dependencies": {
    "@collabboard/contracts": "workspace:*",
    "@nestjs/common": "12.5.1",
    "@nestjs/core": "12.5.1",
    "@nestjs/platform-express": "12.5.1",
    "@nestjs/swagger": "12.1.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/pg": "^8.15.5",
    "esbuild": "^0.28.2",
    "tsx": "4.23.15"
  }
}
