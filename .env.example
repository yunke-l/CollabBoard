NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://collabboard:collabboard_local@localhost:5432/collabboard
IDENTITY_PROVIDER=local
# Local accounts use a separate private SQLite store and development mailbox.
# Synthetic shortcuts remain available. Production startup is rejected.
# Use an absolute path to preserve identity/files across launch methods.
# LOCAL_STATE_DIR=/absolute/private/path/collabboard
